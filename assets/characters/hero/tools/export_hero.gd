extends SceneTree
## Deterministic atlas extraction only. All character artwork is generated by image_gen.
const BASE := "res://assets/characters/hero/"
const DIRS := ["down", "left", "up", "right"]
var report: Dictionary = {"art_tool": "built-in image_gen", "idle": [], "draft_walk": []}

func _initialize() -> void:
	DirAccess.make_dir_recursive_absolute(BASE + "source/normalized")
	DirAccess.make_dir_recursive_absolute(BASE + "reports/draft_frames")
	var idle := Image.load_from_file(BASE + "source/idle_generated_v01.png")
	assert(idle != null and not idle.is_empty())
	report.source_size = [idle.get_width(), idle.get_height()]
	report.source_has_alpha = idle.detect_alpha() != Image.ALPHA_NONE
	assert(report.source_has_alpha, "Source must have real transparency")
	for i in 4:
		var cell := Vector2i(idle.get_width() / 2, idle.get_height() / 2)
		var part := idle.get_region(Rect2i(Vector2i(i % 2, i / 2) * cell, cell))
		var output := _normalize(part, DIRS[i], report.idle)
		assert(output.save_png(BASE + "source/normalized/idle_" + DIRS[i] + "_256.png") == OK)
		var small := _resize_alpha(output, Vector2i(128, 128))
		assert(small.save_png(BASE + "textures/idle_" + DIRS[i] + ".png") == OK)
	var walk := Image.load_from_file(BASE + "source/walk_generated_v02_rejected.png")
	for row in 4:
		for col in 4:
			var cell := Vector2i(walk.get_width() / 4, walk.get_height() / 4)
			var part := walk.get_region(Rect2i(Vector2i(col, row) * cell, cell))
			# Preserve failed draft registration as generated so the preview exposes jitter.
			var output := _resize_alpha(part, Vector2i(256, 256))
			report.draft_walk.append({"name": "%s_%d" % [DIRS[row], col], "status": "rejected", "registration": "raw generated cell"})
			assert(output.save_png(BASE + "reports/draft_frames/%s_%d.png" % [DIRS[row], col]) == OK)
	var f := FileAccess.open(BASE + "reports/texture_metrics.json", FileAccess.WRITE)
	f.store_string(JSON.stringify(report, "\t"))
	print(JSON.stringify(report))
	quit()

func _normalize(part: Image, label: String, records: Array) -> Image:
	part.convert(Image.FORMAT_RGBA8)
	var bounds := part.get_used_rect()
	var solid := Rect2i()
	var transparent := 0
	var partial := 0
	for y in part.get_height():
		for x in part.get_width():
			var a := part.get_pixel(x, y).a
			if a == 0: transparent += 1
			elif a < 1: partial += 1
			if a >= 0.5:
				if solid.size == Vector2i.ZERO: solid = Rect2i(x, y, 1, 1)
				else: solid = solid.merge(Rect2i(x, y, 1, 1))
	assert(transparent > 0)
	# Anchor at midpoint between boots in bottom 7% of solid figure, never at weapon bbox center.
	var min_x := part.get_width()
	var max_x := 0
	for y in range(solid.end.y - maxi(2, roundi(solid.size.y * 0.07)), solid.end.y):
		for x in range(solid.position.x, solid.end.x):
			if part.get_pixel(x, y).a >= 0.5:
				min_x = mini(min_x, x)
				max_x = maxi(max_x, x)
	var foot_x := (min_x + max_x + 1) * 0.5
	var factor := 208.0 / solid.size.y
	var size_out := Vector2i(roundi(bounds.size.x * factor), roundi(bounds.size.y * factor))
	var extracted := _resize_alpha(part.get_region(bounds), size_out)
	var origin := Vector2i(roundi(128 - (foot_x - bounds.position.x) * factor), roundi(232 - (solid.end.y - bounds.position.y) * factor))
	print(label, " bounds=", bounds, " solid=", solid, " origin=", origin, " size=", size_out)
	assert(origin.x >= 2 and origin.y >= 2 and origin.x + size_out.x <= 254 and origin.y + size_out.y <= 254, "Frame clipping: " + label)
	var canvas := Image.create(256, 256, false, Image.FORMAT_RGBA8)
	canvas.fill(Color.TRANSPARENT)
	canvas.blit_rect(extracted, Rect2i(Vector2i.ZERO, size_out), origin)
	records.append({"name": label, "input_size": [part.get_width(), part.get_height()], "bounds": [bounds.position.x,bounds.position.y,bounds.size.x,bounds.size.y], "solid_height": solid.size.y, "source_foot": [foot_x,solid.end.y], "scale": factor, "transparent_pixels": transparent, "partial_alpha_pixels": partial, "master_anchor": [128,232], "master_visible_height": 208, "export_position": [origin.x,origin.y], "export_size": [size_out.x,size_out.y]})
	return canvas

func _resize_alpha(input: Image, target: Vector2i) -> Image:
	var result: Image = input.duplicate()
	result.premultiply_alpha()
	result.resize(target.x, target.y, Image.INTERPOLATE_LANCZOS)
	for y in result.get_height():
		for x in result.get_width():
			var p := result.get_pixel(x, y)
			if p.a > 0: result.set_pixel(x, y, Color(p.r / p.a, p.g / p.a, p.b / p.a, p.a))
	result.fix_alpha_edges()
	return result
