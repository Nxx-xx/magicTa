extends SceneTree
## Deterministic crop/scale/registration only; imagery is generated by image_gen.
func _initialize() -> void:
	var manifest := {}
	for id in ["berserker", "warden", "minotaur", "golem"]:
		var source := Image.load_from_file("res://assets/monsters/phase2/source/" + id + ".png")
		if source == null or source.is_empty():
			push_error("Missing generated monster " + id)
			quit(1)
			return
		source.convert(Image.FORMAT_RGBA8)
		var bounds := source.get_used_rect()
		var cut := source.get_region(bounds)
		var scale := minf(208.0 / bounds.size.y, 224.0 / bounds.size.x)
		cut.premultiply_alpha()
		cut.resize(maxi(1,roundi(bounds.size.x * scale)), maxi(1,roundi(bounds.size.y * scale)), Image.INTERPOLATE_LANCZOS)
		# Restore straight alpha after filtering to avoid dark sprite fringes.
		for y in cut.get_height():
			for x in cut.get_width():
				var pixel := cut.get_pixel(x,y)
				if pixel.a > 0:
					cut.set_pixel(x,y,Color(pixel.r/pixel.a,pixel.g/pixel.a,pixel.b/pixel.a,pixel.a))
		var target := Image.create(256,256,false,Image.FORMAT_RGBA8)
		target.fill(Color.TRANSPARENT)
		var position := Vector2i((256-cut.get_width())/2,224-cut.get_height())
		target.blit_rect(cut,Rect2i(Vector2i.ZERO,cut.get_size()),position)
		var path: String = "res://assets/monsters/phase2/textures/" + id + ".png"
		if target.save_png(path) != OK:
			push_error("Cannot save " + id)
			quit(1)
			return
		manifest[id] = {"texture":path,"canvas":[256,256],"anchor":[128,224],"body":[position.x,position.y,cut.get_width(),cut.get_height()],"source_size":[source.get_width(),source.get_height()]}
	var file := FileAccess.open("res://assets/monsters/phase2/asset_manifest.json",FileAccess.WRITE)
	file.store_string(JSON.stringify(manifest,"  "))
	file.close()
	print("Packed four Phase 2 monsters with transparent margins and shared feet baseline.")
	quit()
